// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?
  role  Role    @default(USER)

  hashedPassword String

  emailVerifiedAt DateTime?
  termsAcceptedAt DateTime?

  otpCode              String?
  otpExpiresAt         DateTime?
  otpAttempts          Int       @default(0)
  otpResendAvailableAt DateTime?

  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?

  // Referral code captured at signup, consumed once onboarding creates
  // the Instructor row (later batch).
  pendingReferralCode String?

  instructor Instructor?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([passwordResetTokenHash])
}

enum CurrencyCode {
  NGN
  USD
  GBP
  EUR
  ZAR
  KES
  GHS
  XOF
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
  TWITTER
  WHATSAPP
  LINKEDIN
}

enum PayoutProvider {
  STRIPE
  PAYSTACK
}

enum PayoutStatus {
  NOT_CONNECTED
  PENDING
  CONNECTED
  RESTRICTED
}

enum PlanStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  COMPED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum PageLayout {
  CLASSIC
  COMPACT
  COVER_GRID
}

// Insert-only history — never updated or deleted in place. Startbutton plans
// are immutable, so "changing a price" creates a new row (and a new
// Startbutton plan) and deactivates the old one, rather than mutating it.
// Old rows stay queryable so the webhook can still resolve a legacy
// subscriber's plan code to an interval after the active price moves on.
model SubscriptionPlan {
  id               String          @id @default(cuid())
  currency         CurrencyCode
  interval         BillingInterval
  price            Int
  providerPlanCode String
  // Startbutton's hosted checkout link for this plan code (e.g.
  // https://pay.startbutton.tech/#/subscription/{code}) — returned once at
  // plan-creation time and reused for every instructor who subscribes to
  // this plan, rather than minting a per-transaction URL like Paystack did.
  checkoutLink     String
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())

  @@index([currency, interval, active])
  @@index([providerPlanCode])
}

model Instructor {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name             String
  slug             String   @unique
  photoUrl         String?
  bio              String?
  location         String?
  email            String
  phone            String?
  consultationLink String?
  specialties      String[] @default([])

  currency              CurrencyCode @default(NGN)
  onboardingCompletedAt DateTime?

  // Public booking-page customization.
  themeColor          String     @default("#6355ff")
  backgroundImageUrl  String?
  pageLayout          PageLayout @default(CLASSIC)

  // "Book a video call" offer card — free only for now (no real payment
  // processing exists yet; see VideoCallBooking). consultationLink doubles
  // as the meeting link (Zoom/Google Meet/etc.) for this.
  videoCallEnabled     Boolean @default(false)
  videoCallTitle       String?
  videoCallDescription String?
  videoCallImageUrl    String?
  videoCallPrice       Int?

  // planStatus/trialEndsAt back a no-card 14-day trial: trialEndsAt is set
  // once at signup rather than derived from createdAt, so a support-granted
  // extension is a single-row edit and future trial-length changes don't
  // retroactively shrink trials already in progress. "Expired" isn't its own
  // status — it's TRIALING with a past trialEndsAt (see isTrialExpired in
  // src/lib/trial.ts) — avoiding a cron sweep to keep a stored status in
  // sync. Existing instructors are backfilled with trialEndsAt = null,
  // which isTrialExpired treats as "never expires".
  planStatus  PlanStatus @default(TRIALING)
  trialEndsAt DateTime?

  // Admin-granted free access (see src/app/admin/billing) — a distinct
  // status from ACTIVE since there's no real Paystack subscription behind
  // it. compedUntil null means indefinite, same "never expires" convention
  // as trialEndsAt null (see isTrialExpired).
  compedUntil DateTime?
  compNote    String?

  // Populated once an instructor subscribes (see src/app/dashboard/billing).
  // subscriptionProviderId is Startbutton's subscriber id, required to call
  // the cancel-subscriber endpoint.
  billingInterval         BillingInterval?
  subscriptionProviderId  String?
  subscriptionPlanCode    String?
  subscriptionRenewsAt    DateTime?

  payoutProvider  PayoutProvider @default(STRIPE)
  payoutStatus    PayoutStatus   @default(NOT_CONNECTED)
  payoutAccountId String?
  payoutBankLabel String?

  // Dashboard "get set up" checklist — null while visible, set once the
  // instructor dismisses it. Not reset if they later un-complete a step
  // (e.g. cancel their only class); dismissal is a one-way door.
  checklistDismissedAt DateTime?

  referralCode       String @unique
  commissionRate     Int    @default(20)
  referralClickCount Int    @default(0)

  socials               InstructorSocial[]
  classes               YogaClass[]
  pageViews             PageView[]
  referralsMade         Referral[]             @relation("ReferralsMade")
  referredBy            Referral?              @relation("ReferredBy")
  links                 InstructorLink[]
  newsletterSubscribers NewsletterSubscriber[]
  newsletterCampaigns   NewsletterCampaign[]
  videoCallBookings     VideoCallBooking[]
  activityEvents        AdminActivityEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstructorSocial {
  id           String         @id @default(cuid())
  instructorId String
  instructor   Instructor     @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  platform     SocialPlatform
  handle       String

  @@unique([instructorId, platform])
}

enum ClassMode {
  IN_PERSON
  ONLINE
}

enum ClassStatus {
  DRAFT
  PUBLISHED
  FULL
  CANCELLED
  COMPLETED
}

model YogaClass {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  // Groups occurrences generated from one recurring series; null for
  // one-off classes.
  seriesId String?

  name        String
  coverUrl    String?
  type        String?
  description String?

  startAt         DateTime
  timezone        String
  durationMinutes Int
  mode            ClassMode
  location        String?

  // Stored in the instructor's currency's display unit (e.g. 8000 =
  // NGN 8,000) — converted to minor units only at the payment-provider
  // boundary in a later batch.
  price         Int
  originalPrice Int?
  capacity      Int

  status ClassStatus @default(DRAFT)

  recurringLabel             String?
  recurringDays              String[] @default([])
  deadlineMinutesBeforeStart Int      @default(120)
  cancellationPolicy         String?

  publishedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  waitlist WaitlistEntry[]

  @@index([instructorId])
  @@index([seriesId])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  WAITLIST
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum BookingSource {
  ONLINE
  MANUAL
}

model Booking {
  id      String    @id @default(cuid())
  classId String
  class   YogaClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  // Denormalized for fast "all my bookings" dashboard queries without a
  // join through YogaClass.
  instructorId String

  studentName      String
  studentEmail     String
  studentPhone     String?
  emergencyContact String?
  notes            String?

  status        BookingStatus @default(CONFIRMED)
  paymentStatus PaymentStatus @default(PENDING)
  amount        Int
  currency      CurrencyCode

  // Set once a Paystack transaction is initialized for this booking — null
  // for free bookings (nothing to charge) and manual/offline ones.
  paystackReference String? @unique

  // Paystack's actual fee for this charge, captured from the transaction
  // verify response once payment succeeds — same display unit as `amount`
  // (not minor units), kept as a Float since fees are often fractional
  // (e.g. 0.43) even though `amount` itself is always a whole number. Null
  // until paid, and for free/manual bookings.
  paystackFee Float?

  attended Boolean @default(false)

  bookedAt             DateTime  @default(now())
  reservationExpiresAt DateTime?
  reminderSentAt       DateTime?

  source BookingSource @default(ONLINE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@index([instructorId])
  @@index([studentEmail])
}

model WaitlistEntry {
  id      String    @id @default(cuid())
  classId String
  class   YogaClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  name  String
  email String

  joinedAt   DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([classId, email])
}

// One row per public booking-page load. No pre-aggregated weekly-metrics
// table — analytics queries group these (and Bookings) by week on demand;
// MVP data volume doesn't need pre-aggregation.
model PageView {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  path         String

  createdAt DateTime @default(now())

  @@index([instructorId])
  @@index([createdAt])
}

enum ReferralStatus {
  PENDING
  ACTIVE
  CHURNED
}

// "conversion" (PENDING -> ACTIVE) is meant to trigger on the referred
// instructor's first paid booking, via the payments batch's webhook —
// that batch is on hold pending Stripe/Paystack account setup, so every
// Referral stays PENDING for now. commissionEarned likewise stays 0: Flowboc
// has no subscription billing of its own yet, so there's no revenue event
// to calculate a percentage of.
model Referral {
  id String @id @default(cuid())

  referrerInstructorId String
  referrerInstructor   Instructor @relation("ReferralsMade", fields: [referrerInstructorId], references: [id], onDelete: Cascade)

  referredInstructorId String     @unique
  referredInstructor   Instructor @relation("ReferredBy", fields: [referredInstructorId], references: [id], onDelete: Cascade)

  status           ReferralStatus @default(PENDING)
  plan             String?
  commissionEarned Int            @default(0)

  joinedAt DateTime @default(now())

  @@index([referrerInstructorId])
}

// Public, unauthenticated form — no instructorId, this isn't scoped to a
// tenant.
model ContactMessage {
  id      String  @id @default(cuid())
  name    String
  email   String
  subject String?
  message String
  ip      String?

  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Link-in-bio entries rendered on the public /{slug} page. clickCount is a
// raw counter (no per-event log table) — same "don't pre-aggregate what you
// don't need yet" reasoning as PageView; add a log table later only if a
// click time-series is actually requested.
model InstructorLink {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  label      String
  url        String
  order      Int     @default(0)
  isActive   Boolean @default(true)
  clickCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instructorId, order])
}

enum NewsletterSubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  email  String
  name   String?
  status NewsletterSubscriberStatus @default(SUBSCRIBED)

  // Generated explicitly with randomBytes(24).toString("hex") in the
  // subscribe action, not a Prisma-default id — keeps the unsubscribe
  // secret out of band from the row's cuid.
  unsubscribeToken String @unique

  ip     String?
  source String?

  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instructorId, email])
  @@index([instructorId, status])
  @@index([ip, createdAt])
}

enum NewsletterCampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

// bodyHtml is real HTML from the rich-text composer; the plain-text email
// alternative is derived at send time by stripping tags (see stripHtml in
// src/lib/email.ts) rather than storing a second copy.
model NewsletterCampaign {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  subject  String
  bodyHtml String

  status         NewsletterCampaignStatus @default(DRAFT)
  recipientCount Int                      @default(0)
  sentCount      Int                      @default(0)
  failedCount    Int                      @default(0)
  sentAt         DateTime?
  errorMessage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instructorId, status])
}

// A booking against the instructor's "video call" offer card — deliberately
// separate from Booking (whose classId is required and whose cron jobs are
// class-time-slot-centric). Free only for now: no paymentStatus/amount,
// since there's no real payment processing yet (see Instructor.videoCallPrice).
model VideoCallBooking {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  studentName  String
  studentEmail String

  createdAt DateTime @default(now())

  @@index([instructorId])
}

enum AdminEventType {
  INSTRUCTOR_SIGNED_UP
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_CANCELED
  TRIAL_EXTENDED
  COMP_GRANTED
  CONTACT_MESSAGE
}

// Insert-only platform activity feed for /admin/overview. message is a
// pre-rendered human-readable string (not derived at read time) so the feed
// stays correct even after the referenced instructor changes or is deleted.
model AdminActivityEvent {
  id           String         @id @default(cuid())
  type         AdminEventType
  message      String
  instructorId String?
  instructor   Instructor?    @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())

  @@index([createdAt])
  @@index([instructorId])
}
