// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?

  hashedPassword String

  emailVerifiedAt DateTime?

  otpCode              String?
  otpExpiresAt         DateTime?
  otpAttempts          Int       @default(0)
  otpResendAvailableAt DateTime?

  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?

  // Referral code captured at signup, consumed once onboarding creates
  // the Instructor row (later batch).
  pendingReferralCode String?

  instructor Instructor?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([passwordResetTokenHash])
}

enum CurrencyCode {
  NGN
  USD
  GBP
  EUR
  ZAR
  KES
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
  TWITTER
  WHATSAPP
  LINKEDIN
}

enum PayoutProvider {
  STRIPE
  PAYSTACK
}

enum PayoutStatus {
  NOT_CONNECTED
  PENDING
  CONNECTED
  RESTRICTED
}

model Instructor {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name             String
  slug             String   @unique
  photoUrl         String?
  bio              String?
  location         String?
  email            String
  phone            String?
  consultationLink String?
  specialties      String[] @default([])

  currency              CurrencyCode @default(NGN)
  onboardingCompletedAt DateTime?

  payoutProvider  PayoutProvider @default(STRIPE)
  payoutStatus    PayoutStatus   @default(NOT_CONNECTED)
  payoutAccountId String?
  payoutBankLabel String?

  socials InstructorSocial[]
  classes YogaClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstructorSocial {
  id           String         @id @default(cuid())
  instructorId String
  instructor   Instructor     @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  platform     SocialPlatform
  handle       String

  @@unique([instructorId, platform])
}

enum ClassMode {
  IN_PERSON
  ONLINE
}

enum ClassStatus {
  DRAFT
  PUBLISHED
  FULL
  CANCELLED
  COMPLETED
}

model YogaClass {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  // Groups occurrences generated from one recurring series; null for
  // one-off classes.
  seriesId String?

  name        String
  coverUrl    String?
  type        String?
  description String?

  startAt         DateTime
  timezone        String
  durationMinutes Int
  mode            ClassMode
  location        String?

  // Stored in the instructor's currency's display unit (e.g. 8000 =
  // NGN 8,000) — converted to minor units only at the payment-provider
  // boundary in a later batch.
  price         Int
  originalPrice Int?
  capacity      Int

  status ClassStatus @default(DRAFT)

  recurringLabel             String?
  recurringDays              String[] @default([])
  deadlineMinutesBeforeStart Int      @default(120)
  cancellationPolicy         String?

  publishedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  waitlist WaitlistEntry[]

  @@index([instructorId])
  @@index([seriesId])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  WAITLIST
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum BookingSource {
  ONLINE
  MANUAL
}

model Booking {
  id      String    @id @default(cuid())
  classId String
  class   YogaClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  // Denormalized for fast "all my bookings" dashboard queries without a
  // join through YogaClass.
  instructorId String

  studentName      String
  studentEmail     String
  studentPhone     String?
  emergencyContact String?
  notes            String?

  status        BookingStatus @default(CONFIRMED)
  paymentStatus PaymentStatus @default(PENDING)
  amount        Int
  currency      CurrencyCode

  attended Boolean @default(false)

  bookedAt             DateTime  @default(now())
  reservationExpiresAt DateTime?

  source BookingSource @default(ONLINE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@index([instructorId])
  @@index([studentEmail])
}

model WaitlistEntry {
  id      String    @id @default(cuid())
  classId String
  class   YogaClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  name  String
  email String

  joinedAt   DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([classId, email])
}
